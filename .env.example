# ── Google OAuth (from Google Cloud Console) ──────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Local dev:
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Render production (replace with your actual Render URL):
# GOOGLE_CALLBACK_URL=https://your-app-name.onrender.com/auth/google/callback

# ── Session ────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string

# ── Admin panel login ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── Allowed Google accounts (only these 2 can log in) ─────────────────────────
ALLOWED_EMAIL_1=youremail@gmail.com
ALLOWED_EMAIL_2=secondemail@gmail.com

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (install PostgreSQL locally, or use a free Supabase/Neon DB):
DATABASE_URL=postgresql://user:password@localhost:5432/cloudsafe
# Render sets this automatically from the linked database

# ── App ────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
